# Supabase server-only credentials. Never expose the service role key to browser code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local development fallback only. Production administrators live in Supabase Auth.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_SESSION_SECONDS="28800"
IP_HASH_SECRET="replace-with-a-separate-32-byte-random-secret"

# One-time values used only by `npm run admin:bootstrap` after migration 0004.
# Remove ADMIN_BOOTSTRAP_PASSWORD after the first owner has been created.
ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-one-time-strong-password"
ADMIN_BOOTSTRAP_NAME="System Owner"

# Public production information
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_COMPANY_REGISTRATION=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_BUSINESS_CONTACT=""

# Optional inquiry notifications
INQUIRY_NOTIFICATION_EMAIL=""
INQUIRY_NOTIFICATION_FROM=""
RESEND_API_KEY=""
INQUIRY_WEBHOOK_URL=""
